---
// One route per trip. Renders src/layouts/trips/<slug>.astro if it exists, else default.astro.
import { trips, bySlug } from '../trips';
import Default from '../layouts/trips/default.astro';

export const getStaticPaths = () => trips.map((t) => ({ params: { trip: t.slug } }));
const trip = bySlug(Astro.params.trip!);

const layouts = import.meta.glob('../layouts/trips/[!_]*.astro', { eager: true, import: 'default' }) as Record<string, any>;
const Layout = layouts[`../layouts/trips/${trip.slug}.astro`] ?? Default;
---
<Layout trip={trip} />
