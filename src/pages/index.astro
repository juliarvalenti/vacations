---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { trips, allImages as all } from '../trips';
const base = import.meta.env.BASE_URL;
---
<Base title="Vacations">
  <section class="wrap intro">
    <h1>Where we've been</h1>
    <p>{trips.length} trips · {trips.reduce((n, t) => n + all(t).length, 0)} photos</p>
  </section>

  <section class="wrap list">
    {trips.map((t, i) => {
      const imgs = all(t);
      const picks = [imgs[0], imgs[Math.floor(imgs.length / 3)], imgs[Math.floor(imgs.length * 2 / 3)]];
      return (
        <a class="trip" href={`${base}${t.slug}/`} style={`--i:${i % 2}`}>
          <div class="text">
            <p class="eyebrow">{t.year}</p>
            <h2>{t.title}</h2>
            <p class="sub">{t.subtitle ?? `${t.sections.length} stops`} · {imgs.length} photos</p>
            <span class="go">View album →</span>
          </div>
          <div class="pics">
            {picks.map((img, j) => <Photo img={img} trip={t.slug} sizes="(max-width: 800px) 100vw, 40vw" class={`p${j}`} />)}
          </div>
        </a>
      );
    })}
  </section>
</Base>

<style>
  .intro { padding-block: 40px 24px; }
  h1 { font-size: clamp(40px, 7vw, 96px); }
  .intro p { color: var(--muted); margin: 8px 0 0; }
  .list { display: grid; gap: 64px; padding-block: 24px; }
  .trip { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: center; }
  .trip[style*="--i:1"] .text { order: 2; }
  .trip h2 { font-size: clamp(30px, 4vw, 52px); margin: 8px 0 12px; }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .go { font-size: 13px; font-weight: 600; border-bottom: 1.5px solid var(--accent); padding-bottom: 2px; }
  .pics { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; aspect-ratio: 3 / 2; }
  .pics :global(.photo) { width: 100%; height: 100%; object-fit: cover; border-radius: 3px; cursor: pointer; }
  .pics :global(.p0) { grid-row: 1 / 3; }
  @media (max-width: 800px) { .trip { grid-template-columns: 1fr; gap: 20px; } .trip .text { order: 0 !important; } }
</style>
