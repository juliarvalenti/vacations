---
import type { Img } from '../trips';
interface Props { img: Img; trip: string; sizes?: string; eager?: boolean; class?: string }
const { img, trip, sizes = '(max-width: 800px) 100vw, 50vw', eager = false } = Astro.props;
const p = `${import.meta.env.BASE_URL}assets/${trip}/${img.file}`;
---
<img
  class:list={['photo', Astro.props.class]}
  src={`${p}-1600.webp`}
  srcset={`${p}-800.webp 800w, ${p}-1600.webp 1600w`}
  sizes={sizes}
  width={img.w}
  height={img.h}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  style={`background: url(${p}-24.jpg) center / cover`}
  alt=""
/>
