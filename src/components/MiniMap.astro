---
// Small inline-SVG map for the lightbox: coastline outlines, every visited place as a dot, the
// route between them, and a highlighted dot the lightbox moves to the current photo's place.
// The view zooms to whichever island the current place is on.
import type { Trip } from '../trips';
interface Props { trip: Trip }
const { trip } = Astro.props;

const maps = import.meta.glob('../maps/*.json', { eager: true, import: 'default' }) as Record<string, { shapes: [number, number][][] }>;
const shapes = maps[`../maps/${trip.map}.json`]?.shapes ?? [];
const places = trip.places ?? {};

// Equirectangular, scaled so a degree of longitude ≈ a degree of latitude at this latitude.
const all = shapes.flat();
const lats = all.map(([, lat]) => lat), lons = all.map(([lon]) => lon);
const maxLat = Math.max(...lats), minLon = Math.min(...lons);
const k = Math.cos(((maxLat + Math.min(...lats)) / 2) * Math.PI / 180);
const S = 100; // svg units per degree
const px = (lat: number, lon: number): [number, number] => [+((lon - minLon) * k * S).toFixed(2), +((maxLat - lat) * S).toFixed(2)];

const outlines = shapes.map((ring) => ring.map(([lon, lat]) => px(lat, lon)));
const d = outlines.map((ring) => 'M' + ring.map((p) => p.join(',')).join('L') + 'Z');
const views = outlines.map((ring) => {
  const xs = ring.map((p) => p[0]), ys = ring.map((p) => p[1]);
  return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)];
});
const pts = Object.fromEntries(Object.entries(places).map(([name, [lat, lon]]) => [name, px(lat, lon)]));

// visiting order = first appearance in the page
const order: string[] = [];
for (const s of trip.sections) for (const b of s.blocks) for (const i of b.images)
  if (i.place && pts[i.place] && !order.includes(i.place)) order.push(i.place);
const route = order.map((n) => pts[n].join(',')).join(' ');
---
<figure class="minimap" hidden>
  <svg viewBox={views[0]?.join(' ')} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    {d.map((path) => <path class="land" d={path} />)}
    <polyline class="route" points={route} />
    {Object.values(pts).map(([x, y]) => <circle class="stop" cx={x} cy={y} r="0.5" />)}
    <circle class="here-ring" r="2" />
    <circle class="here" r="0.9" />
  </svg>
  <figcaption><strong></strong><span></span></figcaption>
  <script type="application/json" set:html={JSON.stringify({ pts, views })} />
</figure>

<style>
  .minimap { position: fixed; left: 16px; bottom: 16px; z-index: 2; margin: 0; width: 230px; padding: 10px; border-radius: 10px;
    background: rgba(20, 20, 20, .55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); color: #fff; }
  svg { display: block; width: 100%; height: 150px; }
  .land { fill: rgba(255,255,255,.14); stroke: rgba(255,255,255,.35); stroke-width: .25; vector-effect: non-scaling-stroke; }
  .route { fill: none; stroke: rgba(255,255,255,.35); stroke-width: 1; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; }
  .stop { fill: rgba(255,255,255,.55); }
  .here { fill: var(--accent); stroke: #fff; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .here-ring { fill: none; stroke: var(--accent); stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: .6; }
  figcaption { margin-top: 8px; display: grid; gap: 1px; font-size: 12px; line-height: 1.35; }
  figcaption span { opacity: .7; font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) { .minimap { width: 160px; } svg { height: 100px; } }
</style>
