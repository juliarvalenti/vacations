---
// Fullscreen viewer for every `.photo` inside <main>. Arrow keys / buttons step through them in page order.
// A photo with data-video is a clip's poster: the clip plays here instead.
// On trips with a map (trip.map + trip.places) a mini map shows where the current photo was taken.
import type { Trip } from '../trips';
import MiniMap from './MiniMap.astro';
interface Props { trip?: Trip }
const { trip } = Astro.props;
---
<dialog id="lightbox">
  <button class="close" aria-label="Close">×</button>
  <button class="lb-arrow lb-prev" aria-label="Previous">‹</button>
  <img alt="" />
  <video controls playsinline preload="none" hidden></video>
  <button class="lb-arrow lb-next" aria-label="Next">›</button>
  {trip?.map && trip.places && <MiniMap trip={trip} />}
</dialog>

<style>
  #lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  #lightbox::backdrop { background: rgba(10,10,10,.55); backdrop-filter: blur(18px) saturate(.8); -webkit-backdrop-filter: blur(18px) saturate(.8); }
  #lightbox img, #lightbox video { width: 100vw; height: 100vh; object-fit: contain; padding: 32px; filter: drop-shadow(0 20px 50px rgba(0,0,0,.6)); }
  #lightbox [hidden] { display: none; }
  #lightbox button { position: fixed; z-index: 2; border: 0; background: rgba(255,255,255,.12); color: #fff; cursor: pointer; border-radius: 50%; width: 44px; height: 44px; font-size: 28px; line-height: 1; }
  #lightbox button:hover { background: rgba(255,255,255,.25); }
  .close { top: 16px; right: 16px; }
  .lb-arrow { top: 50%; translate: 0 -50%; }
  .lb-prev { left: 16px; } .lb-next { right: 16px; }
  /* iOS: rapid taps on the arrows shouldn't double-tap-zoom the page (pinch zoom still works) */
  #lightbox, #lightbox button { touch-action: manipulation; }
  @media (pointer: coarse) {
    #lightbox button { width: 52px; height: 52px; }
    .lb-prev { left: 8px; } .lb-next { right: 8px; }
  }
</style>

<script>
  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = lb.querySelector('img')!;
  const lbVideo = lb.querySelector('video')!;
  const photos = [...document.querySelectorAll<HTMLImageElement>('main .photo')];
  let cur = 0;

  // --- mini map ---
  const map = lb.querySelector<HTMLElement>('.minimap');
  type View = [number, number, number, number];
  type Info = { icon: string; blurb: string; url: string; maps: string };
  const mapData: { pts: Record<string, [number, number]>; views: View[]; info: Record<string, Info> } | null =
    map && JSON.parse(map.querySelector('script')!.textContent!);
  const svg = map?.querySelector('svg');
  let view: View | null = null, anim = 0;
  const pad = (v: View): View => {
    const p = Math.max(v[2] - v[0], v[3] - v[1]) * 0.08;
    return [v[0] - p, v[1] - p, v[2] - v[0] + 2 * p, v[3] - v[1] + 2 * p];
  };
  const zoomTo = (target: View) => {
    const from = view ?? target, t0 = performance.now();
    cancelAnimationFrame(anim);
    const step = (t: number) => {
      const e = Math.min(1, (t - t0) / 350), ease = 1 - (1 - e) ** 3;
      view = from.map((f, i) => f + (target[i] - f) * ease) as View;
      svg!.setAttribute('viewBox', view.join(' '));
      if (e < 1) anim = requestAnimationFrame(step);
    };
    anim = requestAnimationFrame(step);
  };
  const updateMap = (photo: HTMLImageElement) => {
    if (!map || !mapData || !svg) return;
    const name = photo.dataset.place, pt = name && mapData.pts[name];
    map.hidden = !pt;
    if (!pt) return;
    const [x, y] = pt;
    for (const c of svg.querySelectorAll('.here, .here-ring')) { c.setAttribute('cx', String(x)); c.setAttribute('cy', String(y)); }
    // zoom to the island containing the point (or the nearest one)
    const dist = (v: View) => Math.hypot(Math.max(v[0] - x, 0, x - v[2]), Math.max(v[1] - y, 0, y - v[3]));
    const island = mapData.views.reduce((a, b) => (dist(b) < dist(a) ? b : a));
    const target = pad(island);
    // size the marker in screen pixels (≈6px radius) whatever the zoom: svg units per px at the target view
    const box = svg.getBoundingClientRect();
    const [bw, bh] = box.width ? [box.width, box.height] : [240, 170];
    const unitsPerPx = Math.max(target[2] / bw, target[3] / bh);
    const r = String(6 * unitsPerPx);
    for (const c of svg.querySelectorAll('.here, .here-ring')) c.setAttribute('r', r);
    zoomTo(target);
    const day = photo.closest<HTMLElement>('[data-heading]')?.dataset.heading;
    const info = mapData.info[name!];
    const q = <T extends HTMLElement>(s: string) => map.querySelector<T>(s)!;
    q('.name').textContent = name!;
    q('.icon').innerHTML = info?.icon ?? ''; // build-time Lucide SVG from our own data
    q('.blurb').textContent = info?.blurb ?? '';
    q('.meta').textContent = day ?? '';
    const maps = q<HTMLAnchorElement>('.maps'), site = q<HTMLAnchorElement>('.site');
    maps.href = info?.maps ?? '';
    maps.hidden = !info?.maps;
    site.href = info?.url ?? '';
    site.hidden = !info?.url;
    q('.site .label').textContent = info?.url.includes('yelp.com') ? 'Yelp' : 'Website';
  };

  const show = (i: number) => {
    cur = (i + photos.length) % photos.length;
    const clip = photos[cur].dataset.video;
    lbVideo.pause();
    lbImg.hidden = !!clip;
    lbVideo.hidden = !clip;
    if (clip) {
      lbVideo.poster = src(cur);
      lbVideo.src = clip;
      // try with sound every time; only fall back to muted if the browser refuses autoplay with audio
      lbVideo.muted = false;
      lbVideo.play().catch(() => { lbVideo.muted = true; lbVideo.play().catch(() => {}); });
    } else {
      lbVideo.removeAttribute('src');
      lbImg.src = src(cur);
    }
    updateMap(photos[cur]);
    // warm the neighbours so arrow keys feel instant
    for (const j of [cur + 1, cur - 1]) new Image().src = src((j + photos.length) % photos.length);
  };
  const src = (i: number) => photos[i].getAttribute('src')!;
  photos.forEach((p, i) => p.addEventListener('click', () => { lb.showModal(); show(i); }));
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
  lb.querySelector('.close')!.addEventListener('click', () => lb.close());
  lb.addEventListener('close', () => lbVideo.pause());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(cur + 1);
    if (e.key === 'ArrowLeft') show(cur - 1);
  });
</script>
