---
// Bespoke page for the honeymoon, in the style of Emily's pre-trip itinerary: full-bleed cover,
// "The Journey" route strip, chapters by where we stayed, and day-by-day sections inside each.
// Each section in content/honeymoon.json is one day (heading = day name, subtitle = date,
// text = the planned stops); blocks are photos grouped by the place they were taken
// (scripts/import_local.py), captioned with the place's blurb from honeymoon.places.json.
import Base from '../Base.astro';
import Grid from '../../components/Grid.astro';
import Photo from '../../components/Photo.astro';
import { allImages, sectionId, sectionsOf, type Trip } from '../../trips';
interface Props { trip: Trip }
const { trip } = Astro.props;
const photos = allImages(trip);
const byFile = (file: string) => photos.find((p) => p.file === file)!;
const cover = trip.hero[0]?.images[0];

// Chapters follow the stays. Subtitles for 1–3 are Emily's, from the original itinerary.
const chapters = [
  { number: 'Chapter One', title: 'South Kona', subtitle: 'Where the ocean is the main character',
    cover: 'img-0480', days: ['September 6', 'September 7', 'September 8', 'September 9'] },
  { number: 'Chapter Two', title: 'Volcano', subtitle: 'Where the island is still being born',
    cover: 'img-0692', days: ['September 10', 'September 11', 'September 12'] },
  { number: 'Chapter Three', title: 'Hilo', subtitle: 'Rainforest, stars, and the rarest birds on Earth',
    cover: 'img-0836', days: ['September 13'] },
  { number: 'Chapter Four', title: 'Oʻahu', subtitle: 'Palaces, tiki bars, and monk seals',
    cover: 'img-1111', days: ['September 14', 'September 15', 'September 16', 'September 17', 'September 18', 'September 19', 'September 20'] },
];
const route = [
  { name: 'South Kona', desc: 'ocean · history · reef' },
  { name: 'Volcano', desc: 'fire · native forest · lava' },
  { name: 'Hilo', desc: 'rainforest · stars · waterfalls' },
  { name: 'Oʻahu', desc: 'palaces · tiki · seals' },
];
const daysOf = (dates: string[]) => trip.sections.filter((s) => dates.includes(s.subtitle ?? ''));
const blurb = (place?: string | null) => (place && trip.places?.[place]?.blurb) || '';
---
<Base title={trip.title} trip={trip} sections={sectionsOf(trip)}>
  <section class="hero">
    {cover && <Photo img={cover} trip={trip.slug} sizes="100vw" eager class="cover" />}
    <div class="hero-overlay"></div>
    <div class="hero-text">
      <div class="subtitle">Honeymoon · September 2026</div>
      <h1>Hawaiʻi</h1>
    </div>
  </section>

  <section class="narrative">
    <p>Two weeks, two islands, a lot of birds.</p>
  </section>

  <div class="divider"></div>

  <section class="route-section">
    <h2>The Journey</h2>
    <p class="route-subtitle">Big Island first, then Oʻahu — coast to volcano to rainforest to the kingdom's capital</p>
    <div class="route-visual">
      {route.map((r, i) => (
        <>
          {i > 0 && <div class="route-arrow">{r.name === 'Oʻahu' ? '✈' : '→'}</div>}
          <div class="route-stop"><div class="stop-name">{r.name}</div><div class="stop-desc">{r.desc}</div></div>
        </>
      ))}
    </div>
  </section>

  {chapters.map((c, ci) => (
    <>
      {ci === 3 && (
        <section class="interlude">
          <div class="divider"></div>
          <p>From fire and forest<br />to the kingdom's capital.</p>
          <div class="divider"></div>
        </section>
      )}
      <section class="chapter-header">
        <Photo img={byFile(c.cover)} trip={trip.slug} sizes="100vw" class="cover" />
        <div class="overlay"></div>
        <div class="chapter-text">
          <div class="chapter-number">{c.number}</div>
          <div class="chapter-title">{c.title}</div>
          <div class="chapter-subtitle">{c.subtitle}</div>
        </div>
      </section>

      {daysOf(c.days).map((s, di) => (
        <>
          {di > 0 && <div class="divider"></div>}
          <article class="day" id={sectionId(s.heading)} data-heading={s.heading}>
            <header class="day-head">
              <div class="day-date">{s.subtitle}</div>
              <h3>{s.heading}</h3>
              {s.text.length > 0 && <ul class="plan">{s.text.map((t) => <li>{t}</li>)}</ul>}
            </header>
            {s.blocks.map((b) => (
              <div class="stop">
                {b.caption && (
                  <div class="stop-head">
                    <h4>{b.caption}</h4>
                    {blurb(b.caption) && <p class="detail">{blurb(b.caption)}</p>}
                  </div>
                )}
                <Grid images={b.images} trip={trip.slug} />
              </div>
            ))}
          </article>
        </>
      ))}
    </>
  ))}

  <section class="closing">
    <h2>We went.</h2>
    <p>Two islands, two weeks, one us.</p>
  </section>
</Base>

<style>
  /* ── cover ── */
  .hero { height: 100vh; display: flex; flex-direction: column; justify-content: flex-end; padding: 60px; position: relative; overflow: hidden; }
  :global(.cover) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* parallax (see script below): oversize the image so the drift never shows an edge */
  .hero :global(.cover), .chapter-header :global(.cover) { transform: translateY(var(--drift, 0)) scale(1.16); will-change: transform; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.1), rgba(0,0,0,.5)); pointer-events: none; }
  .hero-text { position: relative; color: #fff; pointer-events: none; }
  .hero-text h1 { font-size: 4rem; letter-spacing: .04em; line-height: 1.15; margin-bottom: 12px; text-shadow: 0 2px 20px rgba(0,0,0,.3); }
  .hero-text .subtitle { font-size: 1.3rem; letter-spacing: .08em; text-transform: uppercase; opacity: .9; text-shadow: 0 1px 10px rgba(0,0,0,.3); }

  /* ── narrative + dividers ── */
  .narrative { max-width: 640px; margin: 0 auto; padding: 80px 30px; }
  .narrative p { font-size: 1.1rem; margin: 0; text-align: center; font-style: italic; color: var(--ocean); }
  .divider { height: 1px; background: linear-gradient(to right, transparent, var(--gold), transparent); max-width: 200px; margin: 0 auto; }

  /* ── the journey ── */
  .route-section { padding: 80px 30px; text-align: center; background: #fff; }
  .route-section h2 { font-size: 2rem; color: var(--ocean); margin-bottom: 10px; }
  .route-subtitle { color: #666; margin: 0 0 40px; }
  .route-visual { display: flex; align-items: center; justify-content: center; max-width: 900px; margin: 0 auto; flex-wrap: wrap; }
  .route-stop { padding: 16px 12px; }
  .stop-name { font-size: 1.05rem; font-weight: 600; color: var(--ocean); }
  .stop-desc { font-size: .8rem; color: #666; margin-top: 4px; }
  .route-arrow { font-size: 1.5rem; color: var(--gold); padding: 0 8px; }

  /* ── chapter headers ── */
  .chapter-header { height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; overflow: hidden; text-align: center; }
  .chapter-header .overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); pointer-events: none; }
  .chapter-text { position: relative; color: #fff; padding: 30px; pointer-events: none; }
  .chapter-number { font-size: .85rem; letter-spacing: .25em; text-transform: uppercase; opacity: .7; margin-bottom: 16px; }
  .chapter-title { font-size: 3rem; letter-spacing: .03em; margin-bottom: 12px; text-shadow: 0 2px 15px rgba(0,0,0,.3); }
  .chapter-subtitle { font-size: 1.1rem; opacity: .85; max-width: 500px; line-height: 1.6; }

  /* ── days ── */
  .day { max-width: 1100px; margin: 0 auto; padding: 72px 30px; scroll-margin-top: 56px; display: grid; gap: 36px; }
  .day-head { max-width: 640px; margin: 0 auto; text-align: center; }
  .day-date { font-size: .8rem; color: var(--gold); letter-spacing: .1em; text-transform: uppercase; font-weight: 600; margin-bottom: 6px; }
  h3 { font-size: 2rem; color: var(--ocean); margin-bottom: 16px; }
  .plan { list-style: none; margin: 0; padding: 0; color: #666; font-style: italic; font-size: .95rem; display: grid; gap: 2px; }
  .stop { display: grid; gap: 14px; }
  .stop-head { max-width: 640px; }
  h4 { font-size: 1.15rem; font-weight: 600; color: var(--ocean); margin: 0; }
  .detail { font-size: .88rem; color: #666; font-style: italic; margin: 2px 0 0; line-height: 1.6; }
  .day :global(.grid .photo) { border-radius: 0; }

  /* ── interlude + closing ── */
  .interlude { max-width: 640px; margin: 0 auto; padding: 100px 30px; text-align: center; }
  .interlude p { font-size: 1.3rem; color: var(--ocean); font-style: italic; margin: 40px 0; }
  .closing { text-align: center; padding: 100px 30px 120px; background: var(--ocean); color: #fff; margin-top: 40px; }
  .closing h2 { font-size: 2.5rem; margin-bottom: 20px; letter-spacing: .03em; }
  .closing p { font-size: 1.1rem; max-width: 550px; margin: 0 auto; opacity: .85; }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.cover), .chapter-header :global(.cover) { transform: none; }
  }

  @media (max-width: 768px) {
    .hero { padding: 30px; }
    .hero-text h1 { font-size: 2.5rem; }
    .chapter-title { font-size: 2rem; }
    .narrative { padding: 50px 24px; }
    .day { padding: 48px 20px; }
  }
</style>

<script>
  // Slight parallax on the cover and chapter images: as a frame crosses the viewport its image
  // drifts ±7% against the scroll. JS rather than CSS scroll-timelines, which Safari < 26 lacks.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const frames = [...document.querySelectorAll<HTMLElement>('.hero, .chapter-header')];
    const visible = new Set<HTMLElement>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement);
      update();
    });
    frames.forEach((f) => io.observe(f));
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = innerHeight;
      for (const f of visible) {
        const r = f.getBoundingClientRect();
        // -1 when the frame's centre is at the bottom of the screen, +1 at the top
        const p = Math.max(-1, Math.min(1, (vh / 2 - (r.top + r.height / 2)) / ((vh + r.height) / 2)));
        f.querySelector<HTMLElement>('.cover')?.style.setProperty('--drift', `${(p * 7).toFixed(2)}%`);
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    requestAnimationFrame(update);
  }
</script>
