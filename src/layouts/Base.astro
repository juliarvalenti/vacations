---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Lightbox from '../components/Lightbox.astro';
import { themeVars, fontsUrl, type Trip } from '../trips';
interface Props { title: string; trip?: Trip; sections?: { id: string; heading: string }[] }
const { title, trip, sections } = Astro.props;

// Per-trip stylesheet, if one exists at src/styles/trips/<slug>.css
const tripCss = import.meta.glob('../styles/trips/*.css', { query: '?inline', import: 'default', eager: true }) as Record<string, string>;
const extraCss = trip ? tripCss[`../styles/trips/${trip.slug}.css`] : undefined;
---
<!doctype html>
<html lang="en" data-trip={trip?.slug} style={themeVars(trip?.theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl(trip?.theme)} rel="stylesheet" />
    {extraCss && <style set:html={extraCss} />}
  </head>
  <body>
    <TopBar trip={trip} sections={sections} />
    <main><slot /></main>
    <footer class="wrap foot">Family photo albums · {new Date().getFullYear()}</footer>

    <Lightbox />
  </body>
</html>

<style>
  .foot { padding-block: 64px 32px; color: var(--muted); font-size: 13px; border-top: 1px solid var(--line); margin-top: 48px; }

</style>
